# Shared provider configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://127.0.0.1:8045/v1
OPENAI_USER_AGENT=AI-Feedly-Curator/0.1
OPENAI_HTTP_REFERER=
OPENAI_X_TITLE=

# Optional default model for all tasks
OPENAI_MODEL=gpt-4o-mini
# Optional reasoning effort: none, low, medium, high (关闭或调整支持 reasoning 的模型思考过程以提升速度)
# OPENAI_REASONING_EFFORT=none

# Task-specific model overrides
ANALYSIS_OPENAI_MODEL=qwen-flash
SUMMARY_OPENAI_MODEL=deepseek-v3.2
# ANALYSIS_OPENAI_REASONING_EFFORT=none
# SUMMARY_OPENAI_REASONING_EFFORT=none

# Optional independent embedding provider configuration
# If omitted, embedding falls back to DashScope-compatible defaults
# and still reuses OPENAI_API_KEY as a last-resort credential fallback.
# Set RSS_ENABLE_VECTOR_STORE=false to disable all embedding/vector features.
RSS_ENABLE_VECTOR_STORE=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_USER_AGENT=

# Vector store backend
# embedded: local chroma_db/ directory
# http: Docker/self-hosted Chroma server
RSS_VECTOR_BACKEND=embedded
RSS_VECTOR_DB_DIR=chroma_db
RSS_VECTOR_STATE_DIR=vector_store_state
RSS_VECTOR_HTTP_URL=http://127.0.0.1:8000

# TUI Clean Up Unread 默认参数 (直接回车一键执行)
CLEANUP_DEFAULT_LIMIT=0  # 0 或 all 代表全量未读文章，不设上限；也可设数字如 500、1000
CLEANUP_DEFAULT_THRESHOLD=3.0
CLEANUP_DEFAULT_MARK_READ=true
